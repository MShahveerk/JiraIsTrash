# Postgres connection string. Leave blank locally to use the embedded
# PGlite database at .data/pg.
# Neon's pooled connection string works as-is.
DATABASE_URL=

# Shared passcode. When set, visitors must enter it before using the app.
APP_PASSCODE=

# Random value used to sign the session cookie.
# Render generates this from render.yaml. Required when APP_PASSCODE is set
# and you want sessions to survive a restart.
SESSION_SECRET=

# Set to "false" to skip the demo workspace on first boot.
SEED_DEMO=true

# Local server port (default 3000).
PORT=3000

# Local PGlite data directory (default .data/pg).
PGLITE_DIR=.data/pg
